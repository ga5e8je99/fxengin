# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Prisma PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/fxengin?schema=public"

# Security & Authentication
JWT_SECRET="your-jwt-secret-key-here"
ENCRYPTION_SECRET_KEY="your-encryption-key-here"
SUPER_ADMIN_EMAIL="admin@fxengin.com"
SUPER_ADMIN_PASSWORD="secure-password-here"

# Redis Cache & Sessions (Optional)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Media & Storage (S3 / MinIO)
S3_ENDPOINT=""
S3_BUCKET=""
S3_PUBLIC_URL=""

# External Bots
BOT_STATE_URL=""

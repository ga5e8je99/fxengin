@echo off
title FXEngin Local Dev Runner
chcp 65001 >nul

set "NODE_PATH=%LOCALAPPDATA%\Programs\nodejs"
set "PATH=%NODE_PATH%;%PATH%"

:menu
cls
echo ==============================================================================
